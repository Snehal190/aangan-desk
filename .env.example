# Copy to .env.local and fill in. TEAM_PASSCODE and SESSION_SECRET are needed
# to sign in; every other service is optional until you connect it.

APP_URL=http://localhost:3000

# Team login — shared by front desk and designers
TEAM_PASSCODE=
SESSION_SECRET=  # openssl rand -hex 32

# Neon Postgres
DATABASE_URL=

# Vaani AI (vaanivoice.ai) — website voice calls
# Webhook URL in Vaani → Settings → Webhooks: <APP_URL>/api/webhooks/vaani?key=<VAANI_WEBHOOK_SECRET>
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_WEBHOOK_SECRET=
VAANI_VOICE_GENDER=female

# Gemini — in-call replies and post-call analysis
# Comma-separated; rotated when one is busy or rate-limited
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash

# Cal.com — designer bookings
CAL_API_KEY=
CAL_USERNAME=
CAL_EVENT_TYPE_ID=   # the 'Aangan consultation' event type

# Resend — designer handoff email
RESEND_API_KEY=
RESEND_FROM="Aangan Desk <onboarding@resend.dev>"

# HubSpot — founder's view. Service key (Development → Keys → Service keys) with contacts + deals read/write.
# The 'Aangan enquiries' pipeline is created automatically on first sync.
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=
